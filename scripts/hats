#!/usr/bin/env bash
# Start the hat tracker and open it in the browser. Ctrl-C stops it.
#   hats [port]     (default 8765; rebuilds the data first if public/hats.json is missing)
set -euo pipefail
src="$0"; while [ -L "$src" ]; do d="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; [[ "$src" != /* ]] && src="$d/$src"; done
repo="$(cd "$(dirname "$src")/.." && pwd)"
port="${1:-8765}"; url="http://localhost:$port/"
if curl -s -o /dev/null --max-time 1 "$url"; then echo "Already running: $url"; open "$url"; exit 0; fi
if [ ! -f "$repo/public/hats.json" ]; then
  echo "Building hat data..."; GAME_DATA="${GAME_DATA:-$HOME/Projects/game-data-tools}" python3 "$repo/scripts/build_data.py"
fi
(sleep 1; open "$url") &
exec python3 "$repo/scripts/serve.py" "$port"
